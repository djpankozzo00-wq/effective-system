{
  "crons": [
    { "path": "/api/v1/cron/expire-deposits", "schedule": "0 0 * * *" },
    { "path": "/api/v1/cron/remarketing", "schedule": "0 1 * * *" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
